  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["forge/scripts/**/*.ts"],
  "exclude": ["forge/templates", "clients", "node_modules"]
}
