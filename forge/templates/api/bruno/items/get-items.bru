meta {
  name: GET Items
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/items
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response is an array", function() {
    expect(res.body).to.be.an("array");
  });
}
